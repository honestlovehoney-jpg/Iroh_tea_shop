# Local file next to the Prisma schema. On Railway this is file:/data/dev.db.
DATABASE_URL="file:./dev.db"
NANSEN_API_KEY=
NANSEN_AGENT_DAILY_LIMIT=1
TRIPO_API_KEY=
# Optional override for Bitget API requests.
BITGET_API_BASE_URL="https://api.bitget.com"
# Required to run POST /api/bitget/catalog/sync. Keep this server-side.
BITGET_CATALOG_SYNC_TOKEN=
